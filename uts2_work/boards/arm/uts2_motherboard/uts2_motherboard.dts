/dts-v1/;
#include <st/h7/stm32h723Xg.dtsi>
#include <st/h7/stm32h723vgtx-pinctrl.dtsi>


/*
 * WARNING:
 * JP6 and SB72 must be ON when using Ethernet.
 */

/ {
	model = "UTS2 Motherboard (STM32H723VG)";
        compatible = "st,uts2-motherboard";

	chosen {
		zephyr,console = &usart1;
		zephyr,dtcm = &dtcm;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;	
	    zephyr,code-partition = &flash0;
	};

	leds: leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
			label = "User LD1";
		};

		yellow_led: led_1 {
			gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
			label = "User LD2";
		};

		red_led: led_2 {
			gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;
			label = "User LD3";
		};
	};

		
	aliases {
		led0 = &green_led;
		led1 = &yellow_led;
		led2 = &red_led;		
	};
};

&clk_lse {
    status = "disabled";
};

&clk_hse {
    status = "disabled";
    clock-frequency = <32000000>; /* 32 MHz */
    /* Если у вас по схеме подан генератор (меандр), а не пассивный кварц, раскомментируйте строчку ниже: */
    /* hse-bypass; */
};

&clk_lsi {
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};



&clk_hsi {
    hsi-div = <1>;
    status = "okay";
}; 


&pll {
	div-m = <4>;
	mul-n = <32>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "disabled";
};



&rcc {
	clocks = <&clk_hsi>;
	clock-frequency = <64000000>;
	d1cpre = <1>;
	hpre = <2>;    /* HCLK: 275   MHz */
	d1ppre = <2>;  /* APB1: 137.5 MHz */
	d2ppre1 = <2>; /* APB2: 137.5 MHz */
	d2ppre2 = <2>; /* APB3: 137.5 MHz */
	d3ppre = <2>;  /* APB4: 137.5 MHz */
};

&pwr {
	power-supply = "ldo";
};


&pinctrl {
    usart1_tx_pa9: usart1_tx_pa9 {
        pinmux = <STM32_PINMUX('A', 9, AF7)>;
        bias-pull-up;
    };

    usart1_rx_pa10: usart1_rx_pa10 {
        pinmux = <STM32_PINMUX('A', 10, AF7)>;
    };
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

