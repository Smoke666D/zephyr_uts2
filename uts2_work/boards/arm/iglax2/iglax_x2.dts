/dts-v1/;
#include <st/f4/stm32f413Xg.dtsi>
#include <st/f4/stm32f413v(g-h)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "STMicroelectronics STM32F413VG board";
	compatible = "st,igla-x2";

	chosen {	
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	transistor_inputs: transistor-inputs {
		compatible = "gpio-keys";
		status = "okay";

		gray_in: gray_in {
			gpios = <&gpioe 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Transistor Input 1";
		};

		ign_in: ign_in {
			gpios = <&gpioe 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Transistor Input 1";
		};

		in_ch3: in_ch3 {
			gpios = <&gpioe 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Transistor Input 2";
		};

		in_ch4: in_ch4 {
			gpios = <&gpioe 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Transistor Input 2";
		};
	};

	dout_contorl: dout_contorl {
		compatible = "gpio-leds";

		od1: od1 {
			gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;
		};
		od2: od2 {
			gpios = <&gpiod 13 GPIO_ACTIVE_HIGH>;
		};
		od3: od3 {
			gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
		};
		od4: od4 {
			gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>;
		};
		od5: od5 {
			gpios = <&gpioe 6 GPIO_ACTIVE_HIGH>;
		};
		od6: od6 {
			gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
		};
		od7: od7 {
			gpios = <&gpiod 7 GPIO_ACTIVE_HIGH>;
		};
		od8: od8 {
			gpios = <&gpiod 6 GPIO_ACTIVE_HIGH>;
		};
		od9: od9 {
			gpios = <&gpioe 5 GPIO_ACTIVE_HIGH>;
		};
		od10: od10 {
			gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
		};
		od11: od11 {
			gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
		};
		pd_on_in3: pd_on_in3 {
			gpios = <&gpioe 8 GPIO_ACTIVE_HIGH>;
		};
		pd_on_in4: pd_on_in4 {
			gpios = <&gpioe 9 GPIO_ACTIVE_HIGH>;
		};
		out_gate: out_gate {
			gpios = <&gpioe 7 GPIO_ACTIVE_HIGH>;
		};
	};
};

&clk_hsi {
	status = "okay";
};

/* 1. Настройка внешнего кварца (HSE) */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

/* 2. Конфигурация главного умножителя частоты (PLL) */
&pll {
	div-m = <8>;
	mul-n = <72>;
	div-p = <2>;
	div-q = <3>;
	clocks = <&clk_hsi>;
	status = "okay";
};

/* 3. Конфигурация системных шин в блоке RCC */
&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(72)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&clk48 {
	status = "okay";
};

&iwdg {
	status = "disabled";
};

/* Привязываем стандартную метку нового USB-стека к аппаратному контроллеру */
zephyr_udc0: &usbotg_fs {
    status = "okay";
    pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
    pinctrl-names = "default";

    /* Определяем виртуальный UART для CDC ACM внутри контроллера */
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC_ACM_0";
    };
};