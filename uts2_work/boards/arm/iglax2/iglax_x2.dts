/dts-v1/;
#include <st/f4/stm32f413Xg.dtsi>
#include <st/f4/stm32f413v(g-h)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "STMicroelectronics STM32F413VG board";
	compatible = "st,igla-x2";

	chosen {	
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	transistor_inputs: transistor-inputs {
		compatible = "gpio-keys";
		status = "okay";

		gray_in: gray_in {
			gpios = <&gpioe 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Transistor Input 1";
		};

		ign_in: ign_in {
			gpios = <&gpioe 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Transistor Input 1";
		};

		in_ch3: in_ch3 {
			gpios = <&gpioe 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Transistor Input 2";
		};

		in_ch4: in_ch4 {
			gpios = <&gpioe 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Transistor Input 2";
		};
	};

	dout_contorl: dout_contorl {
		compatible = "gpio-leds";

		od1: od1 {
			gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;
		};
		od2: od2 {
			gpios = <&gpiod 13 GPIO_ACTIVE_HIGH>;
		};
		od3: od3 {
			gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
		};
		od4: od4 {
			gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>;
		};
		od5: od5 {
			gpios = <&gpioe 6 GPIO_ACTIVE_HIGH>;
		};
		od6: od6 {
			gpios = <&gpiob 6 GPIO_ACTIVE_HIGH>;
		};
		od7: od7 {
			gpios = <&gpiod 7 GPIO_ACTIVE_HIGH>;
		};
		od8: od8 {
			gpios = <&gpiod 6 GPIO_ACTIVE_HIGH>;
		};
		od9: od9 {
			gpios = <&gpioe 5 GPIO_ACTIVE_HIGH>;
		};
		od10: od10 {
			gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
		};
		od11: od11 {
			gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
		};
		pd_on_in3: pd_on_in3 {
			gpios = <&gpioe 8 GPIO_ACTIVE_HIGH>;
		};
		pd_on_in4: pd_on_in4 {
			gpios = <&gpioe 9 GPIO_ACTIVE_HIGH>;
		};
		out_gate: out_gate {
			gpios = <&gpioe 7 GPIO_ACTIVE_HIGH>;
		};
	};
};

&clk_hsi {
	status = "okay";
};

/* 1. Настройка внешнего кварца (HSE) */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

/* 2. Конфигурация главного умножителя частоты (PLL) */
&pll {
	div-m = <8>;
	mul-n = <72>;
	div-p = <2>;
	div-q = <3>;
	clocks = <&clk_hsi>;
	status = "okay";
};

/* 3. Конфигурация системных шин в блоке RCC */
&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(72)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&clk48 {
	status = "okay";
};

&iwdg {
	status = "disabled";
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&pinctrl {
	quadspi_clk_pb1: quadspi_clk_pb1 {
		pinmux = <STM32_PINMUX('B', 1, AF9)>;
		slew-rate = "very-high-speed";
	};

	quadspi_ncs_pc11: quadspi_ncs_pc11 {
		pinmux = <STM32_PINMUX('C', 11, AF9)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};

	quadspi_io0_pa6: quadspi_io0_pa6 {
		pinmux = <STM32_PINMUX('A', 6, AF10)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};

	quadspi_io1_pa7: quadspi_io1_pa7 {
		pinmux = <STM32_PINMUX('A', 7, AF10)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};

	quadspi_io2_pc4: quadspi_io2_pc4 {
		pinmux = <STM32_PINMUX('C', 4, AF10)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};

	quadspi_io3_pc5: quadspi_io3_pc5 {
		pinmux = <STM32_PINMUX('C', 5, AF10)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};
};

&quadspi {
	status = "okay";
	pinctrl-0 = <&quadspi_clk_pb1 
	             &quadspi_ncs_pc11 
	             &quadspi_io0_pa6 
	             &quadspi_io1_pa7 
	             &quadspi_io2_pc4 
	             &quadspi_io3_pc5>;
	pinctrl-names = "default";

    flash-id = <2>; 

	mx25l128: qspi-nor-flash@0 {
		compatible = "st,stm32-qspi-nor";
		reg = <0>;                             /* Flash-память на Банке 1 */
		qspi-max-frequency = <40000000>;      /* Частота тактирования (40 МГц) */
		size = <134217728>;
		jedec-id = [c2 20 18];                 /* JEDEC ID для MX25L12835F */
		spi-bus-width = <4>;                   /* Режим Quad-SPI (4 линии данных) */

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Раздел под LittleFS */
			storage_partition: partition@0 {
				label = "storage";
				reg = <0x00000000 0x01000000>;
			};
		};
	};
};
