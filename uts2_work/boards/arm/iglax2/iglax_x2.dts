/dts-v1/;
#include <st/f4/stm32f413Xg.dtsi>
#include <st/f4/stm32f413v(g-h)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "STMicroelectronics STM32F413ZH-NUCLEO board";
	compatible = "st,igla-x2";

	chosen {
		//zephyr,console = &cdc_acm_uart0;
		//zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,ppp-uart = &usart3;
		zephyr,at-shell = &gsm_modem;
	};

	my_custom_inputs {
		/* Вход 1: Статический GND (PE4) */
		din_1 {
			compatible = "zephyr,discrete-input";
			gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
			input-type = "active-high";
			param-id = "din1";
			param-cfg-id = "din1_config";
		};

		/* Вход 2: Статический VDD (PE14) */
		din_2 {
			compatible = "zephyr,discrete-input";
			gpios = <&gpioe 14 GPIO_ACTIVE_LOW>;
			input-type = "active-high";
			param-id = "din2";
			param-cfg-id = "din2_config";
		};

		/* Вход 3: Динамический (PE12), управляемый пином PE8 */
		din_3 {
			compatible = "zephyr,discrete-input";
			gpios = <&gpioe 12 0>;
			input-type = "configurable-low";
			ctrl-gpios = <&gpioe 8 GPIO_ACTIVE_LOW>;
			param-id = "din3";
			param-cfg-id = "din3_config";
		};
	};

	my_custom_outputs {
		dout_1 {
			compatible = "zephyr,discrete-output";
			gpios = <&gpioe 15 GPIO_ACTIVE_HIGH>;
			param-id = "dout1";
		};
		dout_2 {
			compatible = "zephyr,discrete-output";
			gpios = <&gpiod 13 GPIO_ACTIVE_HIGH>;
			param-id = "dout2";
		};
		dout_3 {
			compatible = "zephyr,discrete-output";
			gpios = <&gpiod 15 GPIO_ACTIVE_HIGH>;
			param-id = "dout3";
		};
	};

	/* Виртуальный шлюз-мост для CAN-каналов */
	my_can_instances {
		can_1 {
			compatible = "zephyr,can-instance";
			can-dev = <&can1>;
			stb-gpios = <&gpiod 4 GPIO_ACTIVE_LOW>;
			param-tx-id = "can1_tx_frame";
			param-rx-id = "can1_rx_frame";
			param-status-id = "can1_status";
			param-ctrl-id = "can1_ctrl";
			param-filter-id = "can1_filter";
			param-stb-id = "can1_stb";
		};

		can_2 {
			compatible = "zephyr,can-instance";
			can-dev = <&can2>;
			stb-gpios = <&gpiod 0 GPIO_ACTIVE_LOW>;
			param-tx-id = "can2_tx_frame";
			param-rx-id = "can2_rx_frame";
			param-status-id = "can2_status";
			param-ctrl-id = "can2_ctrl";
			param-filter-id = "can2_filter";
			param-stb-id = "can2_stb";
		};
	};
};

&clk_hsi {
	status = "okay";
};

/* 1. Настройка внешнего кварца (HSE) */
&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

/* 2. Конфигурация главного умножителя частоты (PLL) */
&pll {
	div-m = <8>;
	mul-n = <72>;
	div-p = <2>;
	div-q = <3>;
	clocks = <&clk_hse>;
	status = "okay";
};

/* 3. Конфигурация системных шин в блоке RCC */
&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(72)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&clk48 {
	status = "okay";
};

/* 4. Настройка USB OTG FS */
zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&iwdg {
	status = "disabled";
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_sck_pb10 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;

	lis3dh: lis3dh@0 {
		compatible = "st,lis2dh";
		reg = <0>;
		spi-max-frequency = <10000000>;
		irq-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
		label = "LIS3DH";
	};
};

&adc1 {
	status = "okay";
	pinctrl-0 = <&adc1_in10_pc0>;
	pinctrl-names = "default";
};

&die_temp {
	status = "okay";
};

&vref {
	status = "okay";
};

&vbat {
	status = "okay";
};

&can1 {
	status = "okay";
	pinctrl-0 = <&can1_rx_pb8 &can1_tx_pb9>;
	pinctrl-names = "default";
	bitrate = <500000>;
};

&can2 {
	status = "okay";
	pinctrl-0 = <&can2_rx_pb5 &can2_tx_pb13>;
	pinctrl-names = "default";
	bitrate = <500000>;
};

&can3 {
	status = "okay";
	pinctrl-0 = <&can3_rx_pa8 &can3_tx_pb4>;
	pinctrl-names = "default";
	bitrate = <500000>;
};

&pinctrl {
	quadspi_clk_pb1: quadspi_clk_pb1 {
		pinmux = <STM32_PINMUX('B', 1, AF9)>;
		slew-rate = "very-high-speed";
	};

	quadspi_ncs_pc11: quadspi_ncs_pc11 {
		pinmux = <STM32_PINMUX('C', 11, AF9)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};

	quadspi_io0_pa6: quadspi_io0_pa6 {
		pinmux = <STM32_PINMUX('A', 6, AF10)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};

	quadspi_io1_pa7: quadspi_io1_pa7 {
		pinmux = <STM32_PINMUX('A', 7, AF10)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};

	quadspi_io2_pc4: quadspi_io2_pc4 {
		pinmux = <STM32_PINMUX('C', 4, AF10)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};

	quadspi_io3_pc5: quadspi_io3_pc5 {
		pinmux = <STM32_PINMUX('C', 5, AF10)>;
		bias-pull-up;
		slew-rate = "very-high-speed";
	};
};

&quadspi {
	status = "okay";
	pinctrl-0 = <&quadspi_clk_pb1
		     &quadspi_ncs_pc11
		     &quadspi_io0_pa6
		     &quadspi_io1_pa7
		     &quadspi_io2_pc4
		     &quadspi_io3_pc5>;
	pinctrl-names = "default";
	flash-id = <2>;

	mx25l128: qspi-nor-flash@0 {
		compatible = "st,stm32-qspi-nor";
		reg = <0>;
		qspi-max-frequency = <40000000>;
		size = <134217728>;
		jedec-id = [c2 20 18];
		spi-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			storage_partition: partition@0 {
				label = "storage";
				reg = <0x00000000 0x01000000>;
			};
		};
	};
};

&usart3 {
	status = "okay";
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <9600>;

	gsm_modem: gsm_modem {
		compatible = "simcom,sim7080";
		mdm-power-gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
		mdm-dtr-gpios = <&gpiod 10 GPIO_ACTIVE_LOW>;
		status = "okay";
	};
};