
# Включаем аппаратный математический сопроцессор (Hardware FPU)
CONFIG_FPU=y
# Включаем сохранение контекста fpu 
CONFIG_FPU_SHARING=y

# Включаем поддержку SEGGER RTT
CONFIG_USE_SEGGER_RTT=y
# Переводим стандартный вывод (printk) и консоль в RTT (займет Channel 0)
CONFIG_CONSOLE=y

CONFIG_RTT_CONSOLE=y
CONFIG_UART_CONSOLE=n


# Если используется подсистема логирования Zephyr (LOG_INF/LOG_ERR)
CONFIG_LOG=y
CONFIG_LOG_MODE_IMMEDIATE=y
CONFIG_LOG_BUFFER_SIZE=4096
CONFIG_SEGGER_RTT_BUFFER_SIZE_UP=4096
CONFIG_LOG_BACKEND_RTT=y
CONFIG_LOG_BACKEND_UART=n

# Настройка буферов SEGGER RTT (опционально, под ваши нужды)
CONFIG_SEGGER_RTT_MAX_NUM_UP_BUFFERS=2
CONFIG_SEGGER_RTT_MAX_NUM_DOWN_BUFFERS=2
CONFIG_SEGGER_RTT_BUFFER_SIZE_UP=1024
CONFIG_SEGGER_RTT_BUFFER_SIZE_DOWN=256



